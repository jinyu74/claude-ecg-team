#!/usr/bin/env bash
# 팀 페인 간 메시지 전송 헬퍼 — tmux send-keys + bracketed paste 기반

set -euo pipefail

# ── 페인 매핑 (setup-team.sh 의 1:3:3 레이아웃, row-major 시각 인덱스) ──
#   ┌─────────┬──────────┬──────────┐
#   │         │1 네이선  │2 수진    │
#   │0 제임스 ├──────────┼──────────┤
#   │         │3 마크    │4 정민    │
#   │         ├──────────┼──────────┤
#   │         │5 수영    │6 카맥    │
#   └─────────┴──────────┴──────────┘
pane_for() {
    case "$1" in
        제임스|james|cto) echo 0 ;;
        네이선|nathan|architect) echo 1 ;;
        수진|sujin|researcher) echo 2 ;;
        마크|mark|마크저커버그|zuck|dev|developer) echo 3 ;;
        정민|jungmin|qa|reviewer) echo 4 ;;
        수영|suyoung|design|designer) echo 5 ;;
        카맥|carmack|perf|performance) echo 6 ;;
        *) echo "" ;;
    esac
}

name_for() {
    case "$1" in
        0) echo 제임스 ;;
        1) echo 네이선 ;;
        2) echo 수진 ;;
        3) echo 마크 ;;
        4) echo 정민 ;;
        5) echo 수영 ;;
        6) echo 카맥 ;;
        *) echo 외부 ;;
    esac
}

usage() {
    cat >&2 <<'EOF'
Usage:
  team-send <recipient> "<message>"
  team-send <recipient> -f <file>
  echo "<message>" | team-send <recipient>

Recipients (한국명/영문 alias):
  제임스 james cto         (pane 0, 좌측 메인)
  네이선 nathan architect  (pane 1, 상-중)
  수진   sujin  researcher (pane 2, 상-우)
  마크   mark   developer  (pane 3, 중-중)
  정민   qa     reviewer   (pane 4, 중-우)
  수영   design designer   (pane 5, 하-중)
  카맥   perf   performance(pane 6, 하-우)

옵션:
  --session <name>  대상 tmux 세션 (기본: 현재 세션 또는 team)
  --no-header       발신자/타임스탬프 헤더 생략
EOF
    exit 1
}

# ── 인자 파싱 ────────────────────────────────────────────────
SESSION_OVERRIDE=""
NO_HEADER=0
RECIPIENT=""
MESSAGE=""
FROM_FILE=""

while [ $# -gt 0 ]; do
    case "$1" in
        --session) SESSION_OVERRIDE="$2"; shift 2 ;;
        --no-header) NO_HEADER=1; shift ;;
        -f|--file) FROM_FILE="$2"; shift 2 ;;
        -h|--help) usage ;;
        -*) echo "Unknown option: $1" >&2; usage ;;
        *)
            if [ -z "$RECIPIENT" ]; then
                RECIPIENT="$1"
            elif [ -z "$MESSAGE" ]; then
                MESSAGE="$1"
            else
                MESSAGE="$MESSAGE $1"
            fi
            shift
            ;;
    esac
done

[ -z "$RECIPIENT" ] && usage

# ── 메시지 수집 ──────────────────────────────────────────────
if [ -n "$FROM_FILE" ]; then
    [ -f "$FROM_FILE" ] || { echo "파일 없음: $FROM_FILE" >&2; exit 1; }
    MESSAGE="$(cat "$FROM_FILE")"
elif [ -z "$MESSAGE" ] && [ ! -t 0 ]; then
    MESSAGE="$(cat)"
fi

[ -z "$MESSAGE" ] && { echo "빈 메시지" >&2; exit 1; }

# ── 수신자 페인 결정 ────────────────────────────────────────
IDX="$(pane_for "$RECIPIENT")"
if [ -z "$IDX" ]; then
    echo "알 수 없는 수신자: $RECIPIENT" >&2
    echo "유효한 이름: 제임스 네이선 마크 수영 수진 정민 카맥" >&2
    exit 1
fi

# ── 세션·발신자 식별 ────────────────────────────────────────
if [ -n "$SESSION_OVERRIDE" ]; then
    SESSION="$SESSION_OVERRIDE"
else
    SESSION="$(tmux display-message -p '#S' 2>/dev/null || echo team)"
fi

## 발신자 식별 — TMUX_PANE 환경변수가 자기 페인 ID (%XX) 를 정확히 가짐.
## 단, 호스트 셸 또는 타 세션에서 호출 시 SENDER 는 "외부" 로 표기.
SENDER=""
if [ -n "${TMUX_PANE:-}" ]; then
    SENDER_PANE_SESSION="$(tmux display-message -p -t "$TMUX_PANE" '#{session_name}' 2>/dev/null || echo "")"
    if [ "$SENDER_PANE_SESSION" = "$SESSION" ]; then
        # 같은 세션 내 페인에서 호출 — pane_index 로 이름 매핑
        SENDER_PANE="$(tmux display-message -p -t "$TMUX_PANE" '#{pane_index}' 2>/dev/null || echo "")"
        SENDER="$(name_for "$SENDER_PANE")"
    fi
fi
[ -z "$SENDER" ] && SENDER="외부"
RECIPIENT_NAME="$(name_for "$IDX")"
TARGET="${SESSION}:0.${IDX}"

# ── 수신자 페인 활성 검사 ─────────────────────────────────────
# pane_current_command 가 셸이면 Claude 가 종료된 비활성 상태로 판단.
# 활성 페인은 Claude 버전(예: "2.1.144") 이 표시됨.
TARGET_CMD="$(tmux display-message -p -t "$TARGET" '#{pane_current_command}' 2>/dev/null | tr -d '[:space:]')"
if [ -z "$TARGET_CMD" ]; then
    echo "❌ 수신자 페인을 찾을 수 없습니다 (target=$TARGET, 수신자=$RECIPIENT_NAME)." >&2
    echo "   진단: tmux list-panes -t '$SESSION:0'" >&2
    exit 3
fi
case "$TARGET_CMD" in
    bash|zsh|sh|fish|tcsh|csh|ksh|dash)
        echo "❌ 수신자 페인($IDX, $RECIPIENT_NAME) 이 비활성 상태입니다." >&2
        echo "   현재 실행: $TARGET_CMD (Claude 가 종료됨)" >&2
        echo "   진단: tmux capture-pane -t '$TARGET' -p | tail -10" >&2
        echo "   조치: setup-team.sh 재실행 또는 해당 페인 수동 재시작 필요." >&2
        echo "   ⚠️  발신자 안내: 사용자에게 '대신 전달' 요청 금지. '[시스템 장애] $RECIPIENT_NAME 페인 비활성, 재시작 결정 요청' 형태로만 보고." >&2
        exit 4
        ;;
esac

# ── 페이로드 조립 ───────────────────────────────────────────
if [ "$NO_HEADER" -eq 1 ]; then
    PAYLOAD="$MESSAGE"
else
    PAYLOAD="[From: ${SENDER} → ${RECIPIENT_NAME}] $(date +'%Y-%m-%d %H:%M')

${MESSAGE}"
fi

# ── 전송 (bracketed paste 로 한 청크 주입 → Enter) ──────────
# 긴 메시지 (>2KB) 는 paste 완료까지 시간이 더 걸리므로 동적으로 sleep 조정.
BUFFER="team-msg-$$"
printf '%s' "$PAYLOAD" | tmux load-buffer -b "$BUFFER" -
tmux paste-buffer -b "$BUFFER" -t "$TARGET" -p
tmux delete-buffer -b "$BUFFER"

# paste 안정화 대기: 메시지 길이에 비례. 최소 0.5s, 최대 2s.
# ${#PAYLOAD} 는 문자 수라 UTF-8 한국어에서 ~3배 과소 (Enter 미발동 요인) → wc -c 로 바이트 수 계산.
PAYLOAD_BYTES="$(printf '%s' "$PAYLOAD" | wc -c | tr -d ' ')"
if [ "$PAYLOAD_BYTES" -lt 500 ]; then
    SLEEP_SEC="0.5"
elif [ "$PAYLOAD_BYTES" -lt 2000 ]; then
    SLEEP_SEC="1"
else
    SLEEP_SEC="2"
fi
sleep "$SLEEP_SEC"
tmux send-keys -t "$TARGET" Enter

# ── positive delivery 확인 (Enter 발동 후 입력창 잔존 체크) ─────────
# 판정 신호 (❯ 이후 입력창 구간만 검사 — transcript 에코 제외):
#   (1) "Press up to edit queued" — 큐잉 성공 → OK
#   (2) "Pasted text"             — collapse placeholder 잔존(긴 메시지) → 미제출
#   (3) MSG_PROBE                 — 짧은 메시지 비-collapse 잔존 안전망
# blind-Enter 안전장치: (2)(3) 신호가 ❯ 이후 구간에 있을 때만 재발사.
MSG_PROBE="$(printf '%s' "$PAYLOAD" | head -1 | cut -c1-25)"
_DELIVERED=1
for _i in 1 2 3; do
    sleep 0.7
    _CAP="$(tmux capture-pane -t "$TARGET" -p 2>/dev/null | tail -20)"
    # 큐잉 성공 신호 → 즉시 OK
    printf '%s' "$_CAP" | grep -qF "Press up to edit queued" && { _DELIVERED=1; break; }
    # ❯ 이후 구간(입력창)만 추출 — transcript 에코 방지 (마지막 ❯ 기준)
    _INPUT_AREA="$(printf '%s' "$_CAP" | awk '/❯/{buf=""; found=1} found{buf=buf$0 ORS} END{printf "%s", buf}')"
    # 잔존 검사 먼저 — 입력창에 [Pasted text] 또는 MSG_PROBE 있으면 확정 미제출 → 재발사
    # (제출 성공이면 paste 가 transcript 로 이동해 입력창에서 사라지므로 잔존 = 미제출 확정)
    if printf '%s' "$_INPUT_AREA" | grep -qF "Pasted text" || \
       { [ -n "$MSG_PROBE" ] && printf '%s' "$_INPUT_AREA" | grep -qF "$MSG_PROBE"; }; then
        tmux send-keys -t "$TARGET" Enter 2>/dev/null
        _DELIVERED=0
    else
        _DELIVERED=1; break  # 입력창 비어있음 = 제출 성공 (esc든 idle 이든 무관)
    fi
done
# 3회 소진 후 잔존 신호 잔류 시 경고 — 수동 확인 유도
[ "$_DELIVERED" -eq 0 ] && echo "⚠️ ${SENDER} → ${RECIPIENT_NAME} delivery 미확인 — 수동 확인 권장" >&2

echo "✅ ${SENDER} → ${RECIPIENT_NAME} (pane ${IDX}, ${PAYLOAD_BYTES}B)"
